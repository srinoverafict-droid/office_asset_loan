<odoo>
    <record id="view_office_asset_list" model="ir.ui.view">
        <field name="name">office.asset.list</field>
        <field name="model">office.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="condition"/>
                <field name="is_available"/>
            </list>
        </field>
    </record>

    <record id="view_office_asset_form" model="ir.ui.view">
        <field name="name">office.asset.form</field>
        <field name="model">office.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="loan_count" widget="statinfo"
                                   string="Loans"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="condition"/>
                            <field name="is_available"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Loan History" name="loan_history">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="borrower_id"/>
                                    <field name="loan_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_office_asset_search" model="ir.ui.view">
        <field name="name">office.asset.search</field>
        <field name="model">office.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="available" string="Available"
                        domain="[('is_available', '=', True)]"/>
                <group>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_office_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">office.asset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
